     <source xml:lang="en"><![CDATA[<!-- wp:heading {"level":1} -->
<h1 class="wp-block-heading">Early warning systems save lives</h1>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Early warning systems are a <strong>proven, effective</strong> way to protect lives and livelihoods. Yet only half of all countries report having one in place.</p>
<!-- /wp:paragraph -->

<!-- wp:image {"id":42,"sizeSlug":"large"} -->
<figure class="wp-block-image size-large"><img src="/sites/default/files/example/warning-siren.jpg" alt="A tsunami warning siren on a beach at sunset" class="wp-image-42"/><figcaption class="wp-element-caption">Sirens are one of many ways to reach people quickly.</figcaption></figure>
<!-- /wp:image -->

<!-- wp:heading -->
<h2 class="wp-block-heading">The four pillars</h2>
<!-- /wp:heading -->

<!-- wp:list -->
<ul class="wp-block-list"><!-- wp:list-item -->
<li>Disaster risk knowledge</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Detection, observation, monitoring, analysis and forecasting</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Warning dissemination and communication</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Preparedness and response capabilities</li>
<!-- /wp:list-item --></ul>
<!-- /wp:list -->

<!-- wp:paragraph -->
<p>Read the <a href="/publication/global-status-mhews-2025">Global Status of Multi-Hazard Early Warning Systems</a> report to see where progress is being made.<br>Figures are updated every year.</p>
<!-- /wp:paragraph -->

<!-- wp:buttons -->
<div class="wp-block-buttons"><!-- wp:button -->
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="/early-warnings-for-all">Learn about the initiative</a></div>
<!-- /wp:button -->

<!-- wp:button {"className":"is-style-outline"} -->
<div class="wp-block-button is-style-outline"><a class="wp-block-button__link wp-element-button" href="/contact">Contact the team</a></div>
<!-- /wp:button --></div>
<!-- /wp:buttons -->

<!-- wp:html -->
<style>.ew-note{border-left:4px solid #004f91;padding-left:1rem}</style>
<!-- /wp:html -->

<!-- wp:paragraph {"className":"ew-note"} -->
<p class="ew-note">Questions &amp; feedback are welcome at <em>info@example.org</em>.</p>
<!-- /wp:paragraph -->]]></source>
     <target xml:lang="es"/>
